# ============================================================
# Legal Connect — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=legal_connect
MYSQL_CHARSET=utf8mb4

# Database used by the pytest suite. It is dropped and recreated before every
# test, so it MUST NOT be the same value as MYSQL_DATABASE.
MYSQL_TEST_DATABASE=legal_connect_test

# Create any missing tables at startup (development convenience).
# Schema changes should go through Alembic; set false in production.
AUTO_CREATE_TABLES=true

# --- MySQL TLS (managed providers such as Aiven enforce encrypted connections) ---
# Enable encrypted MySQL connections. Paste the provider's CA certificate PEM into
# MYSQL_SSL_CA for full server verification; with "\n" escapes it is accepted on a
# single line. Set MYSQL_SKIP_DATABASE_CREATION=true when the provider pre-creates
# the database and the app user is not allowed to issue CREATE DATABASE.
MYSQL_SSL_REQUIRED=false
MYSQL_SSL_CA=
MYSQL_SKIP_DATABASE_CREATION=false

# --- MongoDB (legacy) ---
# Only needed by the optional one-shot importer
# scripts/migrate_mongodb_to_mysql.py. The application no longer reads MongoDB.
MONGODB_URI=
MONGODB_DATABASE=legal_connect

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=legal-connect

# --- OpenAI-compatible AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- Email (Resend or SMTP) ---
# Required for account email verification and password-reset links. Configure
# either SMTP (host/from) or a Resend API key; without one, no mail is delivered
# and unverified accounts cannot log in. Reset links expire after 30 minutes.
#
# TEST MODE (Resend, no custom domain): use the built-in test sender
# "onboarding@resend.dev". It can ONLY deliver to the email address registered
# on your Resend account; other recipients are rejected (registration then
# returns 503 on purpose).
#   SMTP_FROM_EMAIL=Legal Connect <onboarding@resend.dev>
#   RESEND_API_KEY=<your Resend API key>
#
# PRODUCTION MODE: after verifying a domain at https://resend.com/domains,
# change SMTP_FROM_EMAIL to an address on that verified domain (example only —
# replace example-domain.com with your real domain):
#   SMTP_FROM_EMAIL=Legal Connect <no-reply@example-domain.com>
# Public users can then receive verification and password-reset emails. No code
# change is required — the app reads SMTP_FROM_EMAIL from the environment.
#
# NO-DOMAIN OPTION (Twilio SendGrid via SMTP): verify a SINGLE SENDER email
# address in SendGrid (no domain purchase) and send to any recipient. Because
# the app prefers Resend whenever RESEND_API_KEY is set, leave RESEND_API_KEY
# empty when using SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=<SendGrid API key with Mail Send scope>   # secret
#   SMTP_FROM_EMAIL=Legal Connect <your-verified-sender-email>
#   SMTP_USE_TLS=true
#   RESEND_API_KEY=
# Free tier: 100 emails per day.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Maps (optional Google Maps; Leaflet/OSM is default) ---
GOOGLE_MAPS_API_KEY=
# Geocoding provider for the "nearby lawyers" office-location backfill.
# Only "nominatim" (OpenStreetMap) is implemented; it needs no API key.
GEOCODING_PROVIDER=nominatim

# --- WebRTC ---
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# --- ZEGOCLOUD video calling (backend only; the ServerSecret must NEVER reach the client) ---
# AppID from https://console.zegocloud.com (Project Information) and its ServerSecret.
ZEGO_APP_ID=
ZEGO_APP_SECRET=

# --- Razorpay payments (backend only; the Key Secret and Webhook Secret must NEVER reach the client) ---
# Key ID / Key Secret from the Razorpay dashboard (Account & Settings > API Keys).
# The webhook secret is the value you set when adding the payment webhook, whose
# URL must be {BACKEND_URL}/api/v1/payments/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

