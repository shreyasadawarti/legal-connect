# Frontend build-time configuration (Vite). Copy this file to `.env.production`
# for production builds, or set the same keys as environment variables in Netlify.
#
# Absolute URL of the deployed FastAPI backend, including the /api/v1 prefix.
# Example: https://legal-connect-backend.onrender.com/api/v1
# If unset, the app falls back to the relative "/api/v1" (only works behind the
# same host, e.g. the Vite dev proxy), so production builds should set this.
VITE_API_URL=

# Optional. WebSocket base URL. When unset it is derived from VITE_API_URL
# (https -> wss, http -> ws). Example: wss://legal-connect-backend.onrender.com
VITE_SOCKET_URL=
