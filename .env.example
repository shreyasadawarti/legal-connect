# ============================================================
# Legal Connect — Environment Variables
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=legal_connect
MYSQL_CHARSET=utf8mb4

# Database used by the pytest suite. It is dropped and recreated before every
# test, so it MUST NOT be the same value as MYSQL_DATABASE.
MYSQL_TEST_DATABASE=legal_connect_test

# Create any missing tables at startup (development convenience).
# Schema changes should go through Alembic; set false in production.
AUTO_CREATE_TABLES=true

# --- MongoDB (legacy) ---
# Only needed by the optional one-shot importer
# scripts/migrate_mongodb_to_mysql.py. The application no longer reads MongoDB.
MONGODB_URI=
MONGODB_DATABASE=legal_connect

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=legal-connect

# --- OpenAI-compatible AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- Email (Resend or SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Maps (optional Google Maps; Leaflet/OSM is default) ---
GOOGLE_MAPS_API_KEY=

# --- WebRTC ---
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
